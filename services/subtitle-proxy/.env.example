PORT=3100
HOST=127.0.0.1

# 代理池（可选）。逗号分隔，支持 socks5/http/https
# PROXY_POOL=socks5://127.0.0.1:1080,http://127.0.0.1:7890
PROXY_COOLDOWN_MS=20000

# 阿里云 OSS（必填）
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-ak
OSS_ACCESS_KEY_SECRET=your-sk

# OSS 对外访问前缀（可选，不配则按 bucket+endpoint 组装）
# OSS_PUBLIC_BASE_URL=https://your-bucket-name.oss-cn-hangzhou.aliyuncs.com
